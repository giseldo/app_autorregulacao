# Supabase — crie o projeto em https://supabase.com e rode as migrations em
# supabase/migrations/ (0001 a 0004, nessa ordem) antes do primeiro uso.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth — o MESMO Client ID/Secret (tipo "Web application") configurado
# em Authentication > Providers > Google no painel do Supabase. Precisamos
# deles aqui de novo porque o Supabase não guarda/renova o provider_token do
# Google depois do login: lib/google/classroom.ts troca o refresh_token salvo
# em google_tokens por um access_token novo a cada chamada à Classroom API.
# Redirect URI a configurar no Google Cloud Console:
#   https://<seu-projeto>.supabase.co/auth/v1/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Chatbot (aluno/professor) — provedor, modelo e chave de API agora são
# configurados pelo próprio professor em /professor/configuracoes (tabela
# llm_settings), não mais só por variável de ambiente. GROQ_API_KEY aqui
# funciona só como valor de bootstrap: se ninguém salvou nada ainda na tela
# de Configurações, o chatbot usa essa chave com a Groq até alguém trocar.
GROQ_API_KEY=

# Cron da dica automática (app/api/cron/auto-tip/route.ts, agendado toda
# segunda 08:00 em vercel.json). Defina esta env var no projeto Vercel — ele
# injeta automaticamente o header `Authorization: Bearer $CRON_SECRET` nas
# chamadas do cron. Gere um valor aleatório, ex: `openssl rand -hex 32`.
CRON_SECRET=
